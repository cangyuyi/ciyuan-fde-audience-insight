APP_ENV=development
STORAGE_BACKEND=memory
LLM_MODE=mock
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://audience:change-me-local-only@localhost:5432/audience
LANGGRAPH_DATABASE_URL=postgresql://audience:change-me-local-only@localhost:5432/audience
# JSON map of service tokens to workspace-scoped roles. Use long random tokens outside this local demo; never commit real values.
API_KEYS_JSON='{"local-query-token":{"workspace":"demo","roles":["insight:read","feedback:write"]},"local-ingest-token":{"workspace":"demo","roles":["evidence:write"]}}'
# Required only when LLM_MODE=openai. Set model IDs via env; do not hardcode in source.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MODEL_FALLBACKS=
MAX_QUESTION_CHARS=1200
MAX_EVIDENCE_ITEMS=8
MAX_EVIDENCE_CHARS=12000
MAX_OUTPUT_TOKENS=1200
MAX_CONCURRENT_LLM=8
# One loop-clock deadline covers graph + semaphore queue + all model attempts/fallbacks.
REQUEST_TIMEOUT_SECONDS=30
LLM_ATTEMPT_TIMEOUT_SECONDS=20
LLM_MAX_ATTEMPTS=2
LLM_MAX_FALLBACKS=1
# Generated directly from M1–M6 by audience-raw-import; no original files are copied here.
SEED_EVIDENCE_PATH=data/evidence.raw.json
