{
  "openapi": "3.1.0",
  "info": {
    "title": "Audience Insight Agent",
    "description": "Evidence-first, workspace-scoped audience insight API.",
    "version": "0.2.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Healthz Healthz Get"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Readyz",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Readyz Readyz Get"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/insights": {
      "post": {
        "tags": [
          "agent"
        ],
        "summary": "Analyze",
        "operationId": "analyze_v1_workspaces__workspace_id__insights_post",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Workspace Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "504": {
            "description": "The total insight deadline was exceeded"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/feedback": {
      "post": {
        "tags": [
          "feedback"
        ],
        "summary": "Feedback",
        "operationId": "feedback_v1_workspaces__workspace_id__feedback_post",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Workspace Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Feedback V1 Workspaces  Workspace Id  Feedback Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces/{workspace_id}/evidence": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Ingest Evidence",
        "operationId": "ingest_evidence_v1_workspaces__workspace_id__evidence_post",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "title": "Workspace Id"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/EvidenceRecord"
                },
                "title": "Body"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "title": "Response Ingest Evidence V1 Workspaces  Workspace Id  Evidence Post"
                }
              }
            }
          },
          "409": {
            "description": "Active or retired dataset versions are immutable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 3,
            "title": "Question"
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80,
                "minLength": 8
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnalyzeRequest"
      },
      "AnalyzeResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "abstained"
            ],
            "title": "Status"
          },
          "dataset_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Version"
          },
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/GroundedClaim"
            },
            "type": "array",
            "title": "Claims"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceCard"
            },
            "type": "array",
            "title": "Evidence"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Next Steps"
          },
          "token_usage": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "type": "object",
            "title": "Token Usage"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "thread_id",
          "status",
          "intent",
          "claims",
          "evidence",
          "limitations",
          "next_steps"
        ],
        "title": "AnalyzeResponse"
      },
      "EvidenceCard": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "source_material": {
            "type": "string",
            "title": "Source Material"
          },
          "source_file": {
            "type": "string",
            "title": "Source File"
          },
          "source_sheet": {
            "type": "string",
            "title": "Source Sheet"
          },
          "source_field": {
            "type": "string",
            "title": "Source Field"
          },
          "source_row": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Row"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "confidence": {
            "type": "string",
            "title": "Confidence"
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source_material",
          "source_file",
          "source_sheet",
          "source_field",
          "source_row",
          "content",
          "confidence",
          "dataset_version"
        ],
        "title": "EvidenceCard"
      },
      "EvidenceRecord": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Id"
          },
          "workspace_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Workspace Id"
          },
          "dataset_version": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Dataset Version"
          },
          "domain": {
            "type": "string",
            "enum": [
              "live_roi",
              "audience_profile",
              "experience",
              "fulfillment",
              "cross_domain"
            ],
            "title": "Domain"
          },
          "record_type": {
            "type": "string",
            "enum": [
              "fact",
              "quote",
              "caveat",
              "recommendation",
              "opinion",
              "hypothesis"
            ],
            "title": "Record Type"
          },
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          },
          "source_material": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Source Material"
          },
          "source_file": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Source File"
          },
          "source_sheet": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Source Sheet"
          },
          "source_field": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Source Field"
          },
          "source_row": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Row"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          },
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "dataset_version",
          "domain",
          "record_type",
          "content",
          "source_material",
          "source_file",
          "source_sheet",
          "source_field",
          "confidence"
        ],
        "title": "EvidenceRecord"
      },
      "FeedbackRequest": {
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid",
            "title": "Run Id"
          },
          "thread_id": {
            "type": "string",
            "maxLength": 160,
            "minLength": 8,
            "title": "Thread Id"
          },
          "dataset_version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Version"
          },
          "decision": {
            "type": "string",
            "enum": [
              "accepted",
              "edited",
              "rejected",
              "needs_validation"
            ],
            "title": "Decision"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "title": "Notes",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "thread_id",
          "dataset_version",
          "decision"
        ],
        "title": "FeedbackRequest"
      },
      "GroundedClaim": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 700,
            "minLength": 1,
            "title": "Text"
          },
          "kind": {
            "type": "string",
            "enum": [
              "observation",
              "inference",
              "recommendation",
              "hypothesis"
            ],
            "title": "Kind"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Evidence Ids"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "title": "Confidence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "kind",
          "evidence_ids",
          "confidence"
        ],
        "title": "GroundedClaim"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "location": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "location",
          "message",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
